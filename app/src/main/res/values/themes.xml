<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Voto" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/voto_yellow</item>
        <item name="colorPrimaryVariant">@color/voto_yellow</item>
        <item name="colorOnPrimary">@color/voto_black</item>
        <item name="colorSecondary">@color/voto_yellow</item>
        <item name="colorOnSecondary">@color/voto_black</item>
        <item name="colorSurface">@color/voto_surface</item>
        <item name="colorOnSurface">@color/voto_white</item>
        <item name="android:colorBackground">@color/voto_background</item>
        <item name="android:windowBackground">@color/voto_background</item>
        <item name="android:statusBarColor">@color/voto_background</item>
        <item name="android:navigationBarColor">@color/voto_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColor">@color/voto_white</item>
        <item name="android:textColorHint">#99FFFFFF</item>
        <item name="android:scrollbarThumbVertical">@drawable/scrollbar_thumb</item>
        <item name="android:scrollbarSize">4dp</item>
        <item name="android:alertDialogTheme">@style/Theme.Voto.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.Voto.Dialog</item>
    </style>

    <style name="Theme.Voto.Dialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/voto_yellow</item>
        <item name="colorSurface">@color/voto_surface</item>
        <item name="colorOnSurface">@color/voto_white</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Voto.DialogButton</item>
    </style>
    <style name="Widget.Voto.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/voto_yellow</item>
    </style>

    <!-- Text styles -->
    <style name="Voto.Text.Label" parent="">
        <item name="android:textColor">@color/voto_white</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Voto.Text.Title" parent="">
        <item name="android:textColor">@color/voto_white</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Voto.Text.Back" parent="">
        <item name="android:text">@string/back</item>
        <item name="android:textColor">@color/voto_white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Outlined input (EditText) -->
    <style name="Voto.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/voto_white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Yellow pill button -->
    <style name="Voto.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/voto_yellow</item>
        <item name="android:textColor">@color/voto_black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:letterSpacing">0</item>
    </style>
</resources>